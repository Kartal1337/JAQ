{
  "expo": {
    "name": "StudyBuddy AI",
    "slug": "studybuddy-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "studybuddy",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studybuddy.ai",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.studybuddy.ai"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#7C5CFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B1A",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
