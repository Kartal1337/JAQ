# JAQ-AI v2.0 — Örnek .env dosyası
# Bu dosyayı kopyala: cp .env.example .env
# Sonra gerçek değerlerini gir, ASLA git'e commit etme!

# ── Zorunlu ────────────────────────────────────────────────────────────────────

# Anthropic Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxx...

# Tavily Web Search — https://tavily.com
TAVILY_API_KEY=tvly-xxxx...

# Telegram Bot — @BotFather'dan al
TELEGRAM_BOT_TOKEN=123456789:ABCdef...

# Telegram Chat ID — @userinfobot'a mesaj at, sana ID'ni söyler
TELEGRAM_CHAT_ID=123456789

# ── İsteğe Bağlı ───────────────────────────────────────────────────────────────

# Model seçimi (varsayılan: claude-sonnet-4-6)
# MODEL_NAME=claude-sonnet-4-6

# Maksimum token (varsayılan: 8192)
# MODEL_MAX_TOKENS=8192

# Yanıt yaratıcılığı 0.0-1.0 (varsayılan: 0.3)
# MODEL_TEMPERATURE=0.3

# Tavily sonuç sayısı (varsayılan: 6)
# TAVILY_MAX_RESULTS=6

# ChromaDB konumu (varsayılan: ./data/chroma_db)
# CHROMA_PERSIST_DIR=./data/chroma_db

# Hafıza geçmiş limiti (varsayılan: 10)
# MEMORY_HISTORY_LIMIT=10

# LangGraph checkpoint DB (varsayılan: ./data/checkpoints.db)
# CHECKPOINT_DB_PATH=./data/checkpoints.db

# Log seviyesi: DEBUG | INFO | WARNING | ERROR (varsayılan: INFO)
# LOG_LEVEL=INFO

# Agent timeout saniye (varsayılan: 60)
# AGENT_TIMEOUT_SECONDS=60

# Debug modu (varsayılan: false)
# DEBUG_MODE=false

# ── Rate Limiting ───────────────────────────────────────────────────────────────

# Saat başına max istek (varsayılan: 20)
# RATE_LIMIT_REQUESTS=20

# Pencere süresi saniye (varsayılan: 3600 = 1 saat)
# RATE_LIMIT_WINDOW_SECONDS=3600

# Burst koruması — 10 saniyede max istek (varsayılan: 5)
# RATE_LIMIT_BURST=5

# ── Input Validation ────────────────────────────────────────────────────────────

# Maksimum girdi uzunluğu karakter (varsayılan: 4000)
# MAX_INPUT_LENGTH=4000

# Minimum girdi uzunluğu karakter (varsayılan: 2)
# MIN_INPUT_LENGTH=2
