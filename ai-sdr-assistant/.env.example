# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # server-only, never expose to browser

# ---- Anthropic (required for message generation + reply tagging) ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Lead source (optional in dev — mock data used if unset) ----
APIFY_TOKEN=

# ---- Email sending (optional in dev — sends are logged if unset) ----
RESEND_API_KEY=
DEFAULT_FROM_EMAIL="AI SDR <onboarding@resend.dev>"

# ---- Booking CTA inserted into emails (optional) ----
DEFAULT_BOOKING_URL=https://cal.com/your-handle/15min

# ---- Inngest (local dev runs without keys; set for cloud) ----
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ---- Stripe (only needed when you turn on billing) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...
